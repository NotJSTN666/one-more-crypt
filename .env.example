# Copy to .env.local for local development. In GitHub, set these as repository
# variables (Settings -> Secrets and variables -> Actions -> Variables) without the VITE_ prefix:
# SUPABASE_URL, SUPABASE_ANON_KEY, AUTH_X.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_AUTH_X=false
